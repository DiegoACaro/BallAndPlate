
%Supongamos valores para las constantes:
const = 0.027 / (0.027 + 4.32e-6 / 0.02^2);
g = 9.81;

a = [ 0  1   0  0;
      0  0  const*g 0;
      0  0   0  1;
      0  0   0  0 ];

%b = [ 0;
      0;
      0;
      1 ];

b = [0 0;
      0 0;
      0 0;
      1 1];  % o la distribución real de tus actuadores


c = [ 1 0 0 0;
      0 0 1 0 ];

d = 0;


%a=[0,1;-((l*Mm*g)/IT),-((l*M*g)/IT)];
%b=[0;l/IT]
%c=[1,0] %Angulo
%d=0


pd=[-2+4.5826*i,-2-4.5826*i]



aa=[a,zeros(4,2);-c,zeros(2,2)]
%ba=[b;0]
ba = [b; zeros(2,2)]

Co = ctrb(aa, ba);
rankCo = rank(Co);
n = size(aa,1);
fprintf('Tamaño AA = %d, rango de la matriz de controlabilidad = %d\n', n, rankCo);

if rankCo < n
    disp('ATENCIÓN: el sistema aumentado NO es totalmente controlable.');
    % ver subespacio incontrolable (vectores propios de A en el complementario)
    [U,S,V] = svd(Co);
    nullbasis = V(:, rankCo+1:end);
    disp('Base del subespacio no alcanzable (columnas):');
    disp(nullbasis);
end

rankPlant = rank(ctrb(a,b));
fprintf('Rango controlabilidad planta original: %d / %d\n', rankPlant, size(a,1));

pda = [-22+14.58i, -22-14.58i, -20, -30, -40, -50];
%pda=[pd,-20]
kt=place(aa,ba,pda)
kp=kt(1:1,1:2)
ki=kt(1:1,3:3)



po=[-10,-11]
h=place(a',c',po)
h=h'


[numu,denu]=ss2tf(a-h*c,b,kp,0)
[numy,deny]=ss2tf(a-h*c,h,kp,0)


